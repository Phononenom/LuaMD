-- LuaMD -- Mega Drive / Genesis emulator for PS5 via Luac0re.
--
-- Emulation core: fixGB by FIX94 (MIT).
-- PS5 runtime pattern: EmuC0re by egycnq / EgyDevTeam.
-- Delivery: Luac0re by Gezine.
--
-- Generated from lua/gb.lua.in by tools/bin2lua.py -- do not edit lua/gb.lua.

-- Resolve sceKernelDlsym before Luac0re's own guess is used.
--
-- init_dlsym() derives it as a fixed distance from
-- sceKernelGetModuleInfoFromAddr and, on PS5, never checks the answer. It uses
-- 0x450 for firmware 10.00 and up, which is correct, and 0x480 below that,
-- which is not correct for any firmware -- the real distance is 0x340 on 4.xx.
-- Calling the wrong address kills the Lua VM outright, so the loader prints
-- its banner and disappears.
--
-- The address cannot be checked by reading it: PS5 system-module text is
-- execute-only, so reading libkernel faults even where calling it is fine.
-- That is why Luac0re's PS4 path verifies a prologue and its PS5 path does
-- not. Ask the kernel instead -- sys_dynlib_dlsym needs no offset, reads
-- nothing, and is correct on every firmware.
--
-- Wrapped: on anything unexpected, fall through to the built-in path rather
-- than taking the loader down, which is the failure being fixed.
pcall(function()
    if type(sceKernelDlsym) == "function" then return end

    local out = malloc(8)
    write64(out, 0)
    if syscall.dlsym(LIBKERNEL_HANDLE, "sceKernelDlsym", out) ~= 0 then
        DLSYM_FIX_MSG = "sys_dynlib_dlsym refused; using the built-in guess"
        return
    end

    local addr = read64(out)
    if not addr or addr == 0 then
        DLSYM_FIX_MSG = "sys_dynlib_dlsym returned no address"
        return
    end

    SCE_KERNEL_DLSYM = addr
    sceKernelDlsym = func_wrap(addr)
    DLSYM_FIX_MSG = string.format("dlsym resolved by syscall at 0x%X", addr)
end)

init_dlsym()
sceMsgDialogTerminate()

-- Where the UDP debug log is sent. Listen with:  nc -u -l -p 9027
--
-- "auto" derives the destination from the console's own address and sends to
-- the subnet broadcast, so it works on any network with nothing to configure.
-- A hardcoded address here would be wrong for everybody except whoever built
-- it, and it fails by producing no log at all rather than an error.
--
-- Set an explicit "a.b.c.d" instead if you would rather log to one machine.
local PC_IP    = "auto"
local LOG_PORT = 9027
local WEB_PORT = 9030

local function htons(p) return ((p << 8) | (p >> 8)) & 0xFFFF end

local function inet_addr(s)
    local a, b, c, d = s:match("(%d+)%.(%d+)%.(%d+)%.(%d+)")
    return (d << 24) | (c << 16) | (b << 8) | a
end

local function make_sockaddr_in(port, ip)
    local sa = malloc(16)
    for i = 0, 15 do write8(sa + i, 0) end
    write8(sa + 0, 16)
    write8(sa + 1, 2)
    write16(sa + 2, htons(port))
    if ip then write32(sa + 4, inet_addr(ip)) end
    return sa
end

-- Resolve "auto" to this console's subnet broadcast address. get_current_ip()
-- is a Luac0re builtin, so the console can work this out for itself.
if PC_IP == "auto" then
    local own = tostring(get_current_ip() or "")
    local a, b, c = own:match("(%d+)%.(%d+)%.(%d+)%.%d+")
    if a then
        PC_IP = a .. "." .. b .. "." .. c .. ".255"
    else
        -- Could not read our own address; fall back to the all-subnets
        -- broadcast, which still reaches a listener on the same segment.
        PC_IP = "255.255.255.255"
    end
end

local log_sock = create_socket(AF_INET, SOCK_DGRAM, 0)

-- Sending to a broadcast address is refused with EACCES unless SO_BROADCAST is
-- set. BSD values: SOL_SOCKET 0xffff, SO_BROADCAST 0x0020 -- the PS5 kernel is
-- FreeBSD-derived, and the Linux numbers differ.
if log_sock >= 0 then
    local bcast_en = malloc(4)
    write32(bcast_en, 1)
    syscall.setsockopt(log_sock, 0xffff, 0x0020, bcast_en, 4)
end

local log_sa   = make_sockaddr_in(LOG_PORT, PC_IP)

local function ulog(m)
    if log_sock >= 0 then
        syscall.sendto(log_sock, m .. "\n", #m + 1, 0, log_sa, 16)
    end
end

ulog("=== LuaMD v0.1")

if not sceKernelLoadStartModule then
    sceKernelLoadStartModule = func_wrap(dlsym(LIBKERNEL_HANDLE, "sceKernelLoadStartModule"))
end

local libUser   = sceKernelLoadStartModule("libSceUserService.sprx", 0, 0, 0, 0, 0)
local getUserId = dlsym(libUser, "sceUserServiceGetInitialUser")
local uid_buf   = malloc(4)
write32(uid_buf, 0)
if getUserId then func_wrap(getUserId)(uid_buf) end
local userId = read32(uid_buf)
ulog("userId=" .. tostring(userId))

-- Web controller listener.
local web_sock = create_socket(AF_INET, 1, 0)
if web_sock >= 0 then
    local ba = make_sockaddr_in(WEB_PORT)
    local en = malloc(4)
    write32(en, 1)
    syscall.setsockopt(web_sock, SOL_SOCKET, SO_REUSEADDR, en, 4)
    syscall.bind(web_sock, ba, 16)
    syscall.listen(web_sock, 128)
    ulog("Web controller on port " .. WEB_PORT)
else
    ulog("Web socket failed")
end

-- Button mask on the wire matches MD_BTN_* in src/mdglue.h, whose bit
-- positions in turn match the ClownMDEmu_Button enum so the core can test
-- them with a shift. Twelve buttons means the mask is 16 bits wide here,
-- where the Game Boy port only needed 8.
--   UP 1  DOWN 2  LEFT 4  RIGHT 8
--   A 16  B 32  C 64  X 128  Y 256  Z 512  START 1024  MODE 2048
--   65534 = back to the picker, 65535 = quit
local html_body = [=[
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>LuaMD</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;touch-action:manipulation}
html,body{width:100%;height:100%;overflow:hidden;position:fixed}
body{background:#0b1410;color:#9bbc0f;font-family:ui-monospace,Menlo,Consolas,monospace;
display:flex;align-items:center;justify-content:center;user-select:none;-webkit-user-select:none}
.shell{width:min(96vw,560px);height:min(88vh,420px);background:linear-gradient(165deg,#2b2f2a,#171b16);
border-radius:18px 18px 60px 18px;padding:14px 18px;display:flex;flex-direction:column;
box-shadow:0 18px 50px rgba(0,0,0,.7),inset 0 1px 0 rgba(255,255,255,.06)}
.top{display:flex;justify-content:space-between;align-items:center;font-size:11px;letter-spacing:2px;color:#8bac0f}
.dot{width:8px;height:8px;border-radius:50%;background:#243;border:1px solid #354}
.dot.on{background:#9bbc0f;box-shadow:0 0 8px #9bbc0f}
.pad{flex:1;display:flex;align-items:center;justify-content:space-between;padding:0 6px}
.dpad{display:grid;grid-template-columns:repeat(3,46px);grid-template-rows:repeat(3,46px)}
.dpad b{background:#20241f;border:1px solid #333;border-radius:8px;display:flex;align-items:center;
justify-content:center;font-size:15px;color:#7a8f5a}
.dpad b:active,.dpad b.hit{background:#3a4a2a;color:#d6f5a8}
.dpad i{visibility:hidden}
.ab{display:flex;flex-direction:column;gap:8px;align-items:center;transform:rotate(-14deg)}
.xyz{display:flex;gap:10px}
.abc{display:flex;gap:10px}
.sb{width:40px;height:40px;border-radius:50%;background:#2a3550;border:1px solid #3d4a6a;color:#c6d8f2;
display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700}
.sb:active,.sb.hit{background:#42557f}
.rb{width:52px;height:52px;border-radius:50%;background:#5a2044;border:1px solid #7a3060;color:#f2d0e6;
display:flex;align-items:center;justify-content:center;font-size:19px;font-weight:700}
.rb:active,.rb.hit{background:#8a3068}
.btm{display:flex;gap:14px;justify-content:center;padding-top:8px}
.pill{background:#22261f;border:1px solid #3a3f36;border-radius:14px;padding:7px 16px;font-size:11px;
letter-spacing:1px;color:#8bac0f}
.pill:active,.pill.hit{background:#3a4a2a;color:#d6f5a8}
.sys{display:flex;gap:10px}
.sys .pill{border-color:#5a3a3a;color:#c98}
</style>
</head>
<body>
<div class="shell">
  <div class="top">
    <span>LuaMD</span>
    <span class="sys">
      <span class="pill" data-cmd="65534">MENU</span>
      <span class="pill" data-cmd="65535">EXIT</span>
      <span class="dot" id="dot"></span>
    </span>
  </div>

  <div class="pad">
    <div class="dpad">
      <i></i><b data-bit="1">&#9650;</b><i></i>
      <b data-bit="4">&#9664;</b><i></i><b data-bit="8">&#9654;</b>
      <i></i><b data-bit="2">&#9660;</b><i></i>
    </div>
    <div class="ab">
      <div class="xyz">
        <div class="sb" data-bit="128">X</div>
        <div class="sb" data-bit="256">Y</div>
        <div class="sb" data-bit="512">Z</div>
      </div>
      <div class="abc">
        <div class="rb" data-bit="16">A</div>
        <div class="rb" data-bit="32">B</div>
        <div class="rb" data-bit="64">C</div>
      </div>
    </div>
  </div>

  <div class="btm">
    <span class="pill" data-bit="2048">MODE</span>
    <span class="pill" data-bit="1024">START</span>
  </div>
</div>

<script>
var mask = 0, cmd = 0, dot = document.getElementById('dot'), busy = false, dirty = true;

function send() {
  if (busy || !dirty) return;
  busy = true; dirty = false;
  var v = cmd || mask;
  cmd = 0;
  fetch('/b' + v, { method: 'POST', keepalive: true })
    .then(function () { dot.classList.add('on'); })
    .catch(function () { dot.classList.remove('on'); })
    .finally(function () { busy = false; });
}
setInterval(send, 16);

function bind(el) {
  var bit = parseInt(el.dataset.bit || 0, 10);
  var c   = parseInt(el.dataset.cmd || 0, 10);
  function on(e) {
    e.preventDefault();
    if (c) { cmd = c; } else { mask |= bit; }
    el.classList.add('hit'); dirty = true;
  }
  function off(e) {
    e.preventDefault();
    if (!c) mask &= ~bit;
    el.classList.remove('hit'); dirty = true;
  }
  el.addEventListener('touchstart', on, { passive: false });
  el.addEventListener('touchend', off, { passive: false });
  el.addEventListener('touchcancel', off, { passive: false });
  el.addEventListener('mousedown', on);
  el.addEventListener('mouseup', off);
  el.addEventListener('mouseleave', off);
}
[].forEach.call(document.querySelectorAll('[data-bit],[data-cmd]'), bind);

// Keyboard. Z/X/C are the bottom row A/B/C, A/S/D the six-button row above,
// matching how the buttons sit on a real pad.
var KEYS = { KeyZ: 16, KeyX: 32, KeyC: 64,
             KeyA: 128, KeyS: 256, KeyD: 512,
             Enter: 1024, ShiftLeft: 2048, ShiftRight: 2048,
             ArrowUp: 1, ArrowDown: 2, ArrowLeft: 4, ArrowRight: 8 };
document.addEventListener('keydown', function (e) {
  if (KEYS[e.code]) { mask |= KEYS[e.code]; dirty = true; e.preventDefault(); }
});
document.addEventListener('keyup', function (e) {
  if (KEYS[e.code]) { mask &= ~KEYS[e.code]; dirty = true; e.preventDefault(); }
});

// Any attached gamepad, polled alongside the touch layer.
// Same arrangement as the native DualSense mapping in src/main.c, so a pad
// behaves identically whether it reaches the emulator through scePad or
// through this page.
var GP = [
  [2, 16],    // west   -> A
  [0, 32],    // south  -> B
  [1, 64],    // east   -> C
  [3, 128],   // north  -> X
  [6, 256],   // L2     -> Y
  [7, 512],   // R2     -> Z
  [9, 1024],  // start
  [8, 2048],  // select -> MODE
  [12, 1], [13, 2], [14, 4], [15, 8]
];
setInterval(function () {
  var pads = navigator.getGamepads ? navigator.getGamepads() : [];
  for (var i = 0; i < pads.length; i++) {
    var p = pads[i];
    if (!p) continue;
    var m = 0;
    for (var k = 0; k < GP.length; k++) {
      var b = p.buttons[GP[k][0]];
      if (b && b.pressed) m |= GP[k][1];
    }
    if (p.axes.length > 1) {
      if (p.axes[0] < -0.5) m |= 4;
      if (p.axes[0] >  0.5) m |= 8;
      if (p.axes[1] < -0.5) m |= 1;
      if (p.axes[1] >  0.5) m |= 2;
    }
    if (p.buttons[4] && p.buttons[4].pressed) cmd = 65534;
    if (p.buttons[5] && p.buttons[5].pressed) cmd = 65535;
    if (m !== mask) { mask = m; dirty = true; }
    return;
  }
}, 16);
</script>
</body>
</html>
]=]

local html_resp = "HTTP/1.1 200 OK\r\nContent-Type:text/html\r\nConnection:close\r\n\r\n" .. html_body
local html_len  = #html_resp
local html_mem  = malloc(html_len + 16)
write_buffer(html_mem, html_resp)
ulog("HTML: " .. html_len .. " bytes")

-- FTP control and data sockets, bound here so the payload never calls socket().
local ftp_srv = create_socket(AF_INET, 1, 0)
if ftp_srv >= 0 then
    local en = malloc(4); write32(en, 1)
    syscall.setsockopt(ftp_srv, SOL_SOCKET, 0x0004, en, 4)   -- SO_REUSEADDR
    syscall.setsockopt(ftp_srv, SOL_SOCKET, 0x0200, en, 4)   -- SO_REUSEPORT
    local ret = syscall.bind(ftp_srv, make_sockaddr_in(1337), 16)
    ulog("ftp_srv fd=" .. tostring(ftp_srv) .. " bind=" .. tostring(ret))
    syscall.listen(ftp_srv, 128)
end

local ftp_data = create_socket(AF_INET, 1, 0)
if ftp_data >= 0 then
    local en = malloc(4); write32(en, 1)
    syscall.setsockopt(ftp_data, SOL_SOCKET, 0x0004, en, 4)
    syscall.setsockopt(ftp_data, SOL_SOCKET, 0x0200, en, 4)
    local ret = syscall.bind(ftp_data, make_sockaddr_in(1338), 16)
    ulog("ftp_data fd=" .. tostring(ftp_data) .. " bind=" .. tostring(ret))
    syscall.listen(ftp_data, 128)
end

-- The payload blob: code plus the initial contents of .data.
local sc = [[
@@SC@@
]]

sc = sc:gsub("%s", "")
local bin = hex_to_binary(sc)

-- Reservation covers code + .data + .bss, not just the blob. The payload runs
-- from a PROT_READ|PROT_EXECUTE alias, so _start maps anonymous RW memory over
-- the tail of this range to give itself writable globals; keeping the whole
-- span inside one existing mapping is what makes that MAP_FIXED safe.
local JIT_SIZE = @@JIT_SIZE@@

local bfd  = jit_malloc(8)
local rwfd = jit_malloc(8)
local rxfd = jit_malloc(8)
local rwa  = jit_malloc(8)
local rxa  = malloc(8)
local nm   = jit_malloc(8)

-- Every step is checked before the next one uses its result. An unchecked
-- failure here is fatal to the whole game process: a null rw would be handed
-- to jit_memcpy and take ps2emu (and Luac0re with it) down, which costs a
-- relaunch and tells us nothing. Reporting and stopping is always better.
local function jitfail(what, extra)
    ulog(string.format("JIT FAIL at %s%s", what, extra and (" -- " .. extra) or ""))
    send_notification("LuaMD\nJIT setup failed at\n" .. what)
    return nil
end

jit_write_buffer(nm, "gb4b")
ulog(string.format("JIT: requesting 0x%X bytes", JIT_SIZE))

local r = jit_sceKernelJitCreateSharedMemory(nm, JIT_SIZE, 7, bfd)
local base_fd = jit_read32(bfd)
ulog(string.format("JIT: CreateSharedMemory ret=%s fd=%s", tostring(r), tostring(base_fd)))
if base_fd == 0 or base_fd == 0xFFFFFFFF then
    return jitfail("CreateSharedMemory", string.format("size 0x%X may be too large", JIT_SIZE))
end

r = jit_sceKernelJitCreateAliasOfSharedMemory(base_fd, PROT_READ | PROT_WRITE, rwfd)
local rw_fd = jit_read32(rwfd)
r = jit_sceKernelJitCreateAliasOfSharedMemory(base_fd, PROT_READ | PROT_EXECUTE, rxfd)
local rx_fd = jit_read32(rxfd)
ulog(string.format("JIT: alias rw_fd=%s rx_fd=%s", tostring(rw_fd), tostring(rx_fd)))
if rw_fd == 0 or rx_fd == 0 or rw_fd == 0xFFFFFFFF or rx_fd == 0xFFFFFFFF then
    return jitfail("CreateAliasOfSharedMemory")
end

r = jit_sceKernelJitMapSharedMemory(rw_fd, PROT_READ | PROT_WRITE, rwa)
local rw = jit_read64(rwa)
ulog(string.format("JIT: map RW ret=%s addr=0x%X", tostring(r), rw))
if rw == 0 then
    return jitfail("JitMapSharedMemory(RW)",
                   string.format("0x%X bytes refused", JIT_SIZE))
end

local mfd = jit_send_recv_fd(rx_fd, NEW_JIT_SOCK, NEW_MAIN_SOCK)
ulog("JIT: rx fd passed to main process, mfd=" .. tostring(mfd))
if mfd < 0 then return jitfail("send_recv_fd") end

r = sceKernelJitMapSharedMemory(mfd, PROT_READ | PROT_EXECUTE, rxa)
local rx = read64(rxa)
ulog(string.format("JIT: map RX ret=%s addr=0x%X", tostring(r), rx))
if rx == 0 then return jitfail("JitMapSharedMemory(RX)") end

write_shellcode(rw, sc)
ulog(string.format("Code: %d bytes written, reserve 0x%X, rx=0x%X", #bin, JIT_SIZE, rx))

-- ext_args, mirroring struct ext_args in src/core.h.
--   +0x00 s64 status        +0x08 s64 step        +0x10 u32 frame_count
--   +0x18 s32 log_fd        +0x1C s32 pad_fd      +0x20 u8  log_addr[16]
--   +0x30 dbg[0] web listen fd     +0x38 dbg[1] HTML buffer
--   +0x40 dbg[2] HTML length       +0x48 dbg[3] userId
--   +0x50 dbg[4] FTP control fd    +0x58 dbg[5] FTP data fd
local ext = malloc(0x80)
memset(ext, 0, 0x80)
write64(ext + 0x00, 0xDEAD)
write32(ext + 0x18, log_sock)
write32(ext + 0x1C, -1)
for i = 0, 15 do write8(ext + 0x20 + i, read8(log_sa + i)) end
write64(ext + 0x30, web_sock >= 0 and web_sock or -1)
write64(ext + 0x38, html_mem)
write64(ext + 0x40, html_len)
write64(ext + 0x48, userId)
write64(ext + 0x50, ftp_srv >= 0 and ftp_srv or -1)
write64(ext + 0x58, ftp_data >= 0 and ftp_data or -1)

local current_ip = get_current_ip()
ulog("IP: " .. tostring(current_ip))
send_notification("LuaMD\nhttp://" .. tostring(current_ip) .. ":" .. WEB_PORT)

func_wrap(rx)(EBOOT_BASE, SCE_KERNEL_DLSYM, ext)

local status = read64(ext + 0x00)
local step   = read64(ext + 0x08)
local frames = read32(ext + 0x10)
ulog(string.format("Done. status=%d step=%d frames=%d", status, step, frames))
send_notification(string.format("GB done\nstatus %d step %d\n%d frames", status, step, frames))
